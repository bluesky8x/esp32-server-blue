# Local overrides — copy to data/.config.yaml and fill in API keys.
# data/ is gitignored. Blue defaults (Kira, vi/en, motor, VAD) are in ../config.yaml.

server:
  # LAN IP of the machine running xiaozhi-server (robot OTA/WebSocket):
  websocket: ws://192.168.68.71:8000/xiaozhi/v1/
  vision_explain: http://192.168.68.71:8003/mcp/vision/explain
  timezone_offset: +7

LLM:
  GeminiLLM:
    api_key: YOUR_GEMINI_API_KEY

ASR:
  OpenaiASR:
    api_key: YOUR_OPENAI_API_KEY

# --- VieNeu TTS (Docker on same LAN host, port 8882) ---
# Start: ./run-vieneu-tts.sh up
# Test:  curl http://192.168.68.71:8882/voices
#
# IMPORTANT:
# - URL must include /v1/audio/speech (not just :8882/)
# - voice must match running container — run ./run-vieneu-tts.sh voices
#   pnnbao97 upstream: Ngọc Lan, Ngọc Linh, Trúc Ly, Mỹ Duyên
#   xuanhieu fork (old image): Thục Đoan, Thùy Dung, Ngọc Linh, …

selected_module:
  TTS: CustomTTS

language_runtime:
  default_locale: vi
  locales:
    vi:
      tts_voice: vieneu-v3-turbo
      # Until pnnbao97 rebuild: use Thục Đoan (nữ miền Nam) on old container
      tts_speeches_voice: Thục Đoan
      # After ./run-vieneu-tts.sh build && up (pnnbao97):
      # tts_speeches_voice: Ngọc Lan
    en:
      tts_voice: vieneu-v3-turbo
      tts_speeches_voice: Ngọc Lan

TTS:
  CustomTTS:
    type: custom
    method: POST
    # Full path required:
    url: "http://192.168.68.71:8882/v1/audio/speech"
    # Same machine, server process on host: http://127.0.0.1:8882/v1/audio/speech
    # Server in Docker on Mac: http://host.docker.internal:8882/v1/audio/speech
    default_voice: Thục Đoan
    format: wav
    output_dir: tmp/
    params:
      input: "{prompt_text}"
      model: "{model}"
      voice: "{voice}"
      response_format: "wav"
      speed: 1.0

tts_timeout: 30

# Long TTS (weather): split before VieNeu HTTP — avoids 15s timeout
# tts_chunk_max_chars: 160
# tts_chunk_max_words: 35
# tts_max_retries: 2
# Level-1 tts stop: wait for send queue drain only (device handles playback)
# tts_transmission_wait_timeout: 180

# --- Weather (Open-Meteo — free, no API key; AI wx: tag triggers fetch after TTS) ---
# Docs: https://open-meteo.com/en/docs
# default_location: fallback when user says wx:local / wx: and IP geolocation fails
# prefer_country: geocode bias for VN city names (e.g. Sài Gòn → Ho Chi Minh)

plugins:
  get_weather:
    provider: open_meteo
    default_location: "Ho Chi Minh City"
    prefer_country: "VN"
