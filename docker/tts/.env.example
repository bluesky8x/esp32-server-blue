# Copy to docker/tts/.env and adjust (optional)
#
# cp docker/tts/.env.example docker/tts/.env

# Piper / Speaches
TTS_HOST_PORT=8881

# VieNeu-TTS (https://github.com/pnnbao97/VieNeu-TTS)
VIENEU_TTS_PORT=8882
VIENEU_DEFAULT_VOICE=Ngọc Lan
# VIENEU_REPO=https://github.com/pnnbao97/VieNeu-TTS.git
# VIENEU_REF=main

# Kokoro-82M (English female voices, CPU/ONNX — ./run-kokoro-tts.sh)
KOKORO_TTS_PORT=8883
KOKORO_DEFAULT_VOICE=af_heart
