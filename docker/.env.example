# Copy to docker/.env and adjust (optional — defaults work for most setups)
#
# cp docker/.env.example docker/.env

# Timezone shown in OTA responses
TZ=Asia/Ho_Chi_Minh

# Host ports (ESP32 / browser use the Ubuntu machine LAN IP + these ports)
SERVER_WS_PORT=8000
SERVER_HTTP_PORT=8003
TTS_HOST_PORT=8881

# Optional: faster pip installs in some regions
# PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
# PIP_TRUSTED_HOST=mirrors.aliyun.com
